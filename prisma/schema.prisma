generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRADER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  password           String
  role               Role       @default(TRADER)
  status             UserStatus @default(PENDING)
  isPublicProfile    Boolean    @default(true)
  isDarkMode         Boolean    @default(true)
  emailNotifications Boolean    @default(true)
  createdAt          DateTime   @default(now())
  trades             Trade[]
}

model Trade {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  pair         String
  direction    String
  entryPrice   Float
  exitPrice    Float?
  positionSize Float
  stopLoss     Float?
  takeProfit   Float?
  contractMultiplier Float @default(1)
  tradeDate    DateTime
  createdAt    DateTime      @default(now())
  journalEntry JournalEntry?
}

model JournalEntry {
  id            String   @id @default(cuid())
  tradeId       String   @unique
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  notes         String?
  emotionTags   String[] // Stored as JSON array in postgres natively or Prisma mapped
  screenshotUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
